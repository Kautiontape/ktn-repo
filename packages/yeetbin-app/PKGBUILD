# Maintainer: Shawn Squire <shawn@shawnsquire.me>
pkgname=yeetbin-app
pkgver=0.2.0
pkgrel=1
pkgdesc="Yeet a file or stdin at yeetbin, or keep it local in the yeetbin browser extension"
arch=('x86_64')
url="https://github.com/Kautiontape/yeetbin-app"
license=('MIT')
depends=('glibc')
makedepends=('go')
# The unrelated 'yeet' pacman wrapper also owns /usr/bin/yeet.
conflicts=('yeet')
# Otherwise makepkg splits a second yeetbin-app-debug package off the Go binary.
options=('!debug')
install=$pkgname.install
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('8544a5da3ad3aaa4b5f01e3da12b1aa79481163c1c12ba1aa7753cf9d9c223f6')

build() {
	cd "$pkgname-$pkgver"
	export CGO_CPPFLAGS="${CPPFLAGS}"
	export CGO_CFLAGS="${CFLAGS}"
	export CGO_CXXFLAGS="${CXXFLAGS}"
	export CGO_LDFLAGS="${LDFLAGS}"
	export GOFLAGS="-buildmode=pie -trimpath -mod=readonly -modcacherw"
	go build -ldflags "-linkmode=external -X main.version=$pkgver" -o yeet .
}

check() {
	cd "$pkgname-$pkgver"
	export GOFLAGS="-trimpath -mod=readonly -modcacherw"
	go test ./...
}

package() {
	cd "$pkgname-$pkgver"
	install -Dm755 yeet "$pkgdir/usr/bin/yeet"
	install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
